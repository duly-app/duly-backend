{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "envFile": "${workspaceFolder}/.env.dev",
            "env": {
                "FLASK_APP": "src.app",
                "FLASK_RUN_PORT": "5001",
                "DATABASE_URL": "postgresql+psycopg2://admin:password@localhost:5432/duly_postgres"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "autoStartBrowser": false
        }
    ]
}
